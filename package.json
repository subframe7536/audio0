{
  "name": "audio0",
  "type": "module",
  "version": "0.3.0",
  "description": "Audio library for the modern browser, auto cross fade",
  "author": "subframe7536",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subframe7536/audio0.git"
  },
  "keywords": [
    "audio",
    "sound",
    "web audio",
    "html5 audio"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bunx vite serve dev",
    "build": "bunx tsdown",
    "release": "bun run build && bumpp --all && bun publish",
    "format": "eslint . --fix"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "zen-mitt": "^3.1.0"
  },
  "devDependencies": {
    "@subframe7536/eslint-config": "^1.3.2",
    "@subframe7536/type-utils": "^0.2.0",
    "bumpp": "^10.2.3",
    "eslint": "^9.34.0",
    "tsdown": "^0.14.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "weighted-shuffle": "1.0.0"
  },
  "patchedDependencies": {
    "weighted-shuffle@1.0.0": "patches/weighted-shuffle@1.0.0.patch"
  }
}
