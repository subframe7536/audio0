{
  "name": "audio0",
  "version": "0.6.2",
  "description": "Audio library for the modern browser, auto cross fade",
  "keywords": [
    "audio",
    "html5 audio",
    "sound",
    "web audio"
  ],
  "license": "MIT",
  "author": "subframe7536",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subframe7536/audio0.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "bun --bun vite serve dev",
    "build": "bun --bun tsdown",
    "release": "bun run build && bumpp --all",
    "qa": "oxfmt && oxlint --fix && tsc --noEmit"
  },
  "dependencies": {
    "zen-mitt": "^3.1.0"
  },
  "devDependencies": {
    "@subf/config": "^0.2.1",
    "bumpp": "^10.4.0",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "tsdown": "^0.21.9",
    "typescript": "^5.9.3",
    "vite": "^8.0.8"
  }
}
