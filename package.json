{
  "name": "audio0",
  "type": "module",
  "version": "0.2.3",
  "description": "Audio library for the modern browser, auto cross fade",
  "author": "subframe7536",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subframe7536/audio0.git"
  },
  "keywords": [
    "audio",
    "sound",
    "web audio",
    "html5 audio"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bun --bun vite serve dev",
    "build": "tsup",
    "release": "pnpm run build && bumpp --all && npm publish",
    "format": "eslint . --fix"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@subframe7536/type-utils": "^0.2.0",
    "zen-mitt": "^3.1.0"
  },
  "devDependencies": {
    "@subframe7536/eslint-config": "^1.3.1",
    "bumpp": "^10.1.1",
    "eslint": "^9.28.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "weighted-shuffle": "^1.0.0"
  },
  "patchedDependencies": {
    "weighted-shuffle@1.0.0": "patches/weighted-shuffle@1.0.0.patch"
  }
}
